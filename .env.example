# ─────────────────────────────────────────────
# blog-auto-publisher 환경변수 (변수 이름만 기록. 실제 값은 .env 또는 GitHub Secrets)
# ─────────────────────────────────────────────

# [필수] Google OAuth 2.0 — Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID (유형: 데스크톱 앱)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [필수] `npm run blogger:auth` 실행 후 출력되는 값
GOOGLE_REFRESH_TOKEN=
BLOGGER_BLOG_ID=

# [Phase 5] Slack Incoming Webhook (발행 결과 알림)
SLACK_WEBHOOK_URL=

# [Phase 3, 선택] 스톡 이미지 API (없으면 직접 제작 인포그래픽만 사용)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# [Phase 3] 이미지·영상 공개 URL 기준 주소 (Blogger API는 미디어 업로드를 지원하지 않음)
# 예: https://cdn.jsdelivr.net/gh/<github-user>/<media-repo>@main
MEDIA_BASE_URL=

# [운영 정책]
# 영상 생성 실패 시 발행 여부: true = 영상 없으면 발행 안 함
REQUIRE_VIDEO=true
# 실행 모드 기본값: preview | publish
DEFAULT_MODE=preview
